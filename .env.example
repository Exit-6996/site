# Local server port
PORT=3000

# Leave blank for a free-only local demo. Add private codes only when needed.
COURSE_ACCESS_CODES=MY-DEMO

# SQLite database file. Keep it outside public static hosting paths.
DATABASE_PATH=./perimeter-academy.sqlite

# Set to 1 only when HTTPS is enabled in production.
COOKIE_SECURE=0
NODE_ENV=development
